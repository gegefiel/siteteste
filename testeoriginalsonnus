<style>

:root{
  --navy:#2C2860;
  --navy-2:#5E5794;
  --cream:#EFEDF9;
  --cream-2:#FAF9FD;
  --orange:#E8952F;
  --orange-2:#F3B968;
  --red:#6D5BC7;
  --red-2:#57489F;
  --hl:#E3DCF7;
  --green:#6FA07E;
  --ink:#2E2A44;
  --ph-bg:#EAE6F2;
  --ph-line:#BBB2CE;
  --maxw:720px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%}
html,body{overflow-x:hidden;max-width:100%;background:var(--cream-2)}
h1,h2,h3,h4,.hl-h3,.maya-title,.display{overflow-wrap:break-word}
body{font-family:'Manrope',Arial,sans-serif;color:var(--ink);background:var(--cream-2);font-size:19px;line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 18px}
.display{font-family:'Sora',Arial,sans-serif;font-weight:700;letter-spacing:0;line-height:1.14;text-transform:none}
h1.display{font-size:clamp(32px,6vw,50px)}
h2.display{font-size:clamp(26px,4.6vw,38px)}
.accent{color:var(--red)}
.accent-o{color:var(--orange)}
section{padding:44px 0}
p{margin:0 0 18px}
em{font-style:italic}
strong{font-weight:800}

/* ===== top bar / header ===== */
.topbar{background:var(--navy);color:#fff;text-align:center;padding:8px 12px;font-size:14px;font-weight:600;letter-spacing:.3px}
.topbar b{color:var(--orange-2)}
header.site{background:var(--cream);border-bottom:1px solid #e2dbc8;padding:14px 0;position:relative;z-index:5}
.logo{font-family:'Sora',Arial,sans-serif;font-size:34px;letter-spacing:2px;color:var(--navy);text-align:center;line-height:1}
.logo span{color:var(--orange)}
.asseen{background:var(--cream);padding:14px 0 18px;border-bottom:1px solid #e2dbc8}
.asseen .row{display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:wrap}
.stars{color:#F5A623;font-size:18px;letter-spacing:2px}
.asseen small{display:block;text-align:center;color:var(--navy-2);font-weight:600;margin-top:6px;font-size:13px;text-transform:uppercase;letter-spacing:1.5px}

/* ===== placeholders ===== */
.ph{background:repeating-linear-gradient(45deg,var(--ph-bg),var(--ph-bg) 14px,#efeadd 14px,#efeadd 28px);border:2px dashed var(--ph-line);border-radius:12px;display:flex;align-items:center;justify-content:center;text-align:center;color:#7d7663;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1px;padding:10px}
.ph-sm{min-height:110px}.ph-md{min-height:220px}.ph-lg{min-height:330px}
.ph-logo{min-height:34px;min-width:88px;font-size:11px;border-radius:12px;flex:0 0 auto}

/* ===== buttons / cta ===== */
.btn{display:block;width:100%;max-width:560px;margin:0 auto;background:var(--red);color:#fff;text-decoration:none;text-align:center;font-weight:800;font-size:22px;padding:20px 26px;border-radius:12px;box-shadow:0 6px 16px rgba(87,72,159,.4);transition:transform .12s ease}
.btn:hover{transform:translateY(-2px)}
.btn .arr{display:inline-block;margin-left:8px;transition:transform .15s}
.btn:hover .arr{transform:translateX(5px)}
.btn-orange{background:var(--orange);box-shadow:0 6px 16px rgba(232,149,47,.38)}
.under-btn{display:flex;gap:8px;align-items:flex-start;justify-content:center;margin-top:14px;font-size:15.5px;font-weight:700;color:var(--navy)}
.under-btn .shield{flex:0 0 auto}

/* ===== hero ===== */
.hero{background:var(--cream);padding:38px 0 48px}
.hero .attention{text-align:center;font-weight:800;color:var(--navy);font-size:18px;margin-bottom:18px}
.hero .attention b{color:var(--red)}
.hero h1{text-align:center;color:var(--navy);margin-bottom:20px}
.hero .sub-em{text-align:center;font-size:22px;font-style:italic;color:var(--navy-2);margin-bottom:8px}
.hero .sub-strong{text-align:center;font-size:21px;font-weight:800;color:var(--ink);max-width:600px;margin:0 auto 26px}
.checkcard{background:#fff;border:1px solid #e7e0cd;border-radius:12px;box-shadow:0 2px 7px rgba(44,40,96,.10);padding:22px 24px;max-width:600px;margin:0 auto 26px}
.checkcard li{list-style:none;display:flex;gap:12px;align-items:flex-start;padding:9px 0;font-size:18.5px;font-weight:600;border-bottom:1px solid #f0ecdf}
.checkcard li:last-child{border-bottom:none}
.checkcard .ck{flex:0 0 auto;color:var(--green);font-size:20px;line-height:1.3}
.hero .heroimg{margin:26px auto}

/* ===== section headers ===== */
.sec-head{text-align:center;color:var(--navy);margin-bottom:10px}
.sec-sub{text-align:center;font-size:20px;color:var(--navy-2);max-width:620px;margin:0 auto 30px}
.band{background:var(--red);color:var(--cream-2);padding:26px 22px;border-radius:0;margin:34px 0}
.band .display{color:#fff;text-align:left}

/* ===== proof / results (diagramação ref. SkinnyFit GLP-1) ===== */
.results{background:#fff;border-top:1px solid #e7e0cd;border-bottom:1px solid #e7e0cd}
.results .wrap-wide{max-width:1200px;margin:0 auto;padding:0 18px}
.rw-kicker{display:block;text-align:center;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--navy-2);font-size:13px;margin-bottom:14px}
.rw-title{font-family:'Sora',Arial,sans-serif;font-weight:800;font-size:clamp(38px,5.6vw,58px);line-height:1.04;text-align:center;color:var(--navy);margin:0}
.rw-title .it{display:block;color:var(--red);font-style:italic}
.rw-sub{text-align:center;color:var(--navy-2);font-size:17px;margin:16px auto 30px}
.rw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:8px 0 4px}
.rw-card{background:#fff;border:1px solid #eee6d4;border-radius:12px;box-shadow:0 2px 6px rgba(44,40,96,.10);display:flex;flex-direction:column;overflow:hidden}
.rw-photo{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:2px;height:240px;background:#efeadd;overflow:hidden}
.rw-img{grid-column:1/-1;width:100%;height:100%;object-fit:cover;display:block}
.rw-photo .ph{border-radius:0;border:none;min-height:0;height:100%}
.rw-badge{position:absolute;bottom:12px;padding:6px 11px;border-radius:12px;color:#fff;line-height:1.15;text-align:left;box-shadow:0 2px 8px rgba(0,0,0,.25)}
.rw-badge small{display:block;font-size:9px;letter-spacing:1.8px;font-weight:800;text-transform:uppercase;opacity:.85}
.rw-badge b{font-size:14.5px;font-weight:800}
.rw-badge.before{left:12px;background:var(--navy)}
.rw-badge.after{right:12px;background:var(--red)}
.rw-body{padding:18px 16px 14px;text-align:center;display:flex;flex-direction:column;flex:1}
.rw-stars{color:#F5A623;letter-spacing:3px;font-size:15px}
.rw-stat{font-size:22px;font-weight:800;color:var(--ink);margin:9px 0 11px;letter-spacing:-.3px}
.rw-quote{font-size:15px;color:var(--navy-2);text-align:left;margin:0 0 14px;line-height:1.5}
.rw-meta{display:flex;justify-content:space-between;align-items:center;gap:8px;border-top:1px solid #f0ecdf;padding-top:11px;margin-top:auto}
.rw-name{font-weight:800;font-size:14.5px;color:var(--ink)}
.rw-verified{color:var(--green);font-weight:800;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap}
.rw-verified:before{content:"✓ ";font-weight:900}
.rw-disc{text-align:center;font-style:italic;color:#8a8471;font-size:13.5px;margin-top:20px}
@media(max-width:900px){.rw-grid{grid-template-columns:1fr;gap:18px;max-width:420px;margin:0 auto}}
@media(min-width:601px) and (max-width:900px){.rw-grid{grid-template-columns:repeat(2,1fr);max-width:760px;gap:20px}}
@media(max-width:640px){
  .rw-sub{font-size:15px;margin:12px auto 20px}
  .rw-grid{gap:14px;max-width:320px}
  .rw-photo{height:210px}
  .rw-disc{margin-top:12px;font-size:12.5px}
}

/* ===== story ===== */
.story{background:var(--cream-2)}
.story-intro{background:var(--cream);padding:44px 0}
.story-intro h2{text-align:center;color:var(--navy);margin-bottom:14px}
.kicker{display:block;text-align:center;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:var(--red);font-size:14px;margin-bottom:12px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;margin:26px 0}
.split.rev .txt{order:2}.split.rev .img{order:1}

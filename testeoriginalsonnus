.blogo{width:auto;filter:brightness(0) invert(1);opacity:.95;object-fit:contain;flex:0 0 auto}
.l-vogue{height:30px}
.l-forbes{height:30px}
.l-womens{height:26px}
.l-vanity{height:26px}
.l-bazaar{height:30px}
.brand.sans{font-family:'Manrope',Arial,sans-serif;font-weight:800;letter-spacing:1px;font-size:20px;text-transform:uppercase}


/* ===== Maya intro (estilo PQ7): foto esquerda + texto direita ===== */
.maya-hero{display:grid;grid-template-columns:280px 1fr;gap:28px;align-items:center;margin:6px 0 10px}
.maya-photo{position:relative;line-height:0;width:280px;aspect-ratio:1/1;overflow:hidden;border-radius:12px}
.maya-photo img{width:100%;height:100%;object-fit:cover;border-radius:12px;border:2px solid var(--navy);display:block;box-sizing:border-box}
@media(max-width:640px){.maya-photo{width:100%}}
.maya-cap{position:absolute;left:14px;bottom:14px;background:#fff;border:2px solid var(--navy);color:var(--navy);font-family:'Manrope',Arial,sans-serif;font-weight:800;font-size:19px;letter-spacing:.5px;padding:6px 14px;box-shadow:4px 4px 0 rgba(44,40,96,.9)}
.maya-txt .maya-title{font-size:clamp(34px,5vw,52px);line-height:1;white-space:nowrap;margin:0 0 16px}
.maya-txt p{margin:0 0 14px}
@media(max-width:640px){
  .maya-hero{grid-template-columns:1fr;gap:16px}
  .maya-photo{max-width:420px;margin:0 auto;width:100%}
  .maya-cap{font-size:19px;left:10px;bottom:10px}
  .maya-txt .maya-title{font-size:clamp(40px,11vw,60px);white-space:normal}
}
.maya-title{font-family:'Sora',Arial,sans-serif;font-weight:400;font-size:clamp(48px,8vw,76px);line-height:.98;text-transform:uppercase;color:var(--navy);margin:0 0 18px;letter-spacing:1px}
.maya-title span{color:var(--red)}
.interstitial{text-align:center;font-size:clamp(24px,4vw,32px);font-weight:800;color:var(--navy);margin:36px 0 22px}

/* ingredientes em linha (estilo PQ7) */
.wrap-wide-ing{max-width:1220px;margin:0 auto;padding:0 18px}
.ing-grid{grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;margin-top:40px}
@media(max-width:999px){.ing-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.ing-grid{grid-template-columns:1fr}}
.ing-card{padding:0;border:1.5px solid var(--navy);border-radius:12px;overflow:visible}
.ing-head{background:var(--navy);color:#fff;border-radius:12px 3px 0 0;padding:14px 78px 12px 16px;position:relative;min-height:66px}
.ing-head .nm{display:block;font-family:'Sora',Arial,sans-serif;font-weight:800;font-size:24px;letter-spacing:.5px;line-height:1;color:#fff}
.ing-head .role{display:block;color:var(--orange-2);font-weight:700;font-size:11.5px;letter-spacing:1.2px;text-transform:uppercase;margin-top:5px}
.ing-png{position:absolute;top:-22px;right:8px;width:84px;height:84px;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(0,0,0,.28))}
.ing-bd{padding:16px 16px 14px;display:flex;flex-direction:column;flex:1}
.ing-bd ul{margin:0 0 14px}
.ing-card .ing-bd li{border-bottom:1px solid #f0ecdf;padding:7px 0}
.ing-card .ing-bd li:last-child{border-bottom:none}
.ing-foot{background:var(--hl);border-radius:12px;padding:10px 12px;text-align:center;margin-top:auto}
.ing-foot .r{display:block;font-weight:800;font-size:13.5px;color:var(--navy)}
.ing-foot .ar{display:block;color:var(--red);font-weight:900;line-height:1.1}
.ing-foot .t{display:block;font-size:13.5px;font-weight:700;color:var(--navy)}

/* ícones dos steps */
.step-ic{width:58px;height:58px;border-radius:50%;background:var(--cream);border:2px solid var(--orange);display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.step{text-align:center}
.step h4{text-align:center}
.maya-intro{max-width:640px}
.step-ic svg{width:28px;height:28px;stroke:var(--red);fill:none;stroke-width:2}

/* calculadora estilo WLP-1 */
.calc-card{padding:0;overflow:hidden;max-width:960px}
.calc-band{background:var(--orange);color:#fff;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 18px;flex-wrap:wrap}
.calc-band .tt{font-weight:800;letter-spacing:2px;font-size:14px;text-transform:uppercase}
.unit-tog{background:rgba(255,255,255,.28);border-radius:12px;padding:3px;display:flex;gap:2px}
.unit-tog button{border:none;background:transparent;color:#fff;font-family:inherit;font-weight:800;font-size:13px;padding:6px 13px;border-radius:12px;cursor:pointer}
.unit-tog button.on{background:var(--navy)}
.calc-cols{display:grid;grid-template-columns:1fr 1.1fr}
@media(max-width:820px){.calc-cols{grid-template-columns:1fr}}
.calc-left{padding:22px;border-right:1px solid #eee6d4}
@media(max-width:820px){.calc-left{border-right:none;border-bottom:1px solid #eee6d4}}
.calc-right{padding:22px;background:#FCF7F4}
.sl-row{margin-bottom:18px}
.sl-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.sl-top label{font-weight:700;font-size:15px;color:var(--navy-2)}
.sl-val{font-weight:800;font-size:25px;color:var(--navy);white-space:nowrap}
.sl-val small{font-size:13px;color:var(--navy-2);font-weight:700}
input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:4px;border-radius:12px;background:#e2dbc8;outline:none;margin:14px 0 6px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:22px;height:22px;border-radius:50%;background:var(--navy);cursor:pointer;border:none;box-shadow:0 2px 6px rgba(0,0,0,.3)}
input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--navy);cursor:pointer;border:none}
.sl-mm{display:flex;justify-content:space-between;font-size:12px;color:#8a8471}
.diff-note{font-size:14.5px;color:var(--navy-2);margin:4px 0 0}
.pj-lbl{font-size:12px;letter-spacing:2px;font-weight:800;color:#8a8471;text-transform:uppercase;margin-bottom:10px}
.pj-flex{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}
.pj-goal{font-size:12.5px;font-weight:800;letter-spacing:1px;color:var(--navy-2);text-transform:uppercase;margin-bottom:4px}
.pj-big{font-family:'Sora',Arial,sans-serif;font-size:58px;color:var(--red);line-height:1}
.pj-big small{font-size:22px;color:var(--navy-2)}
.pj-in{font-size:16px;font-weight:700;color:var(--navy)}
.bmi-box{border:2px solid var(--orange);border-radius:12px;padding:8px 14px;text-align:center;background:#fff;flex:0 0 auto}
.bmi-box .v{font-weight:800;font-size:24px;color:var(--navy);line-height:1.1}
.bmi-box .l{font-size:10px;letter-spacing:1.5px;font-weight:800;color:#8a8471}
.bmi-box .c{font-size:11.5px;font-weight:800;color:var(--orange)}
.traj{background:#fff;border:1px solid #eee6d4;border-radius:12px;padding:12px;margin-top:16px}
.traj .th{display:flex;justify-content:space-between;gap:8px;font-size:10.5px;letter-spacing:1.2px;font-weight:800;color:#8a8471;text-transform:uppercase;margin-bottom:6px}
.traj svg{width:100%;height:auto}
.calc-foot{font-size:11.5px;color:#8a8471;padding:10px 18px;border-top:1px solid #eee6d4;background:#fff}
@media(max-width:640px){.pj-big{font-size:48px}.sl-val{font-size:22px}.calc-left,.calc-right{padding:16px}}

/* timeline do dia (estilo PQ7) */
.day-wide{max-width:1220px;margin:0 auto;padding:0 24px}
.day-tl{position:relative;max-width:1180px;margin:44px auto 0}
.day-tl:before{content:"";position:absolute;left:50%;top:10px;bottom:10px;width:4px;background:var(--orange);transform:translateX(-50%);border-radius:12px}
.dt-item{display:grid;grid-template-columns:1fr 64px 1fr;align-items:center;margin-bottom:30px}
.dt-item:last-child{margin-bottom:0}
.dt-node{grid-column:2;grid-row:1;width:44px;height:44px;border-radius:50%;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;margin:0 auto;border:5px solid var(--cream);position:relative;z-index:2}
.dt-label{display:flex;align-items:center;gap:16px;font-family:'Sora',Arial,sans-serif;font-size:44px;color:var(--navy);text-transform:uppercase;letter-spacing:1px;line-height:1}
.dt-label .em{font-size:40px}
/* Morning/Evening: label esquerda, card direita */
.dt-item .dt-label{grid-column:1;grid-row:1;justify-content:flex-end;padding-right:34px}
.dt-item .dt-card{grid-column:3;grid-row:1;margin-left:34px;position:relative}
.dt-item .dt-card:before{content:"";position:absolute;left:-11px;top:28px;border:11px solid transparent;border-right-color:var(--navy)}
.dt-item .dt-card:after{content:"";position:absolute;left:-8px;top:29px;border:10px solid transparent;border-right-color:#fff}
/* Midday/Night: card esquerda, label direita */
.dt-item.flip .dt-label{grid-column:3;justify-content:flex-start;padding-left:34px;padding-right:0}
.dt-item.flip .dt-card{grid-column:1;margin-left:0;margin-right:34px}
.dt-item.flip .dt-card:before{left:auto;right:-11px;border-right-color:transparent;border-left-color:var(--navy)}
.dt-item.flip .dt-card:after{left:auto;right:-8px;border-right-color:transparent;border-left-color:#fff}
.dt-card{background:#fff;border:1.5px solid var(--navy);border-radius:12px;padding:18px 22px;box-shadow:6px 6px 0 rgba(44,40,96,.08)}
.dt-card ul{margin:0}
.dt-card li{list-style:none;display:flex;gap:10px;padding:6px 0;font-size:17px}
.dt-card li .d{color:var(--orange);flex:0 0 auto;font-weight:900}
@media(max-width:820px){
  .day-tl{max-width:560px}
  .dt-label{font-size:34px}
  .dt-item .dt-card:before,.dt-item .dt-card:after,.dt-item.flip .dt-card:before,.dt-item.flip .dt-card:after{display:none}
  .day-tl:before{left:17px;transform:none}
  .dt-item{grid-template-columns:44px 1fr;margin-bottom:26px;align-items:start}
  .dt-node{grid-column:1;width:32px;height:32px;border-width:3px;margin:0 0 0 1px;font-size:16px}
  .dt-item .dt-label,.dt-item.flip .dt-label{grid-column:2;grid-row:1;justify-content:flex-start;padding:0 0 8px 8px;font-size:28px}
  .dt-item .dt-card,.dt-item.flip .dt-card{grid-column:2;grid-row:2;margin:0 0 0 8px}
}

/* CTA urgência com imagem */
.urg-grid{display:grid;grid-template-columns:170px 1fr;gap:18px;align-items:center;text-align:left;margin-bottom:6px}
.urg-grid .ph{min-height:150px}
@media(max-width:640px){.urg-grid{grid-template-columns:1fr;text-align:center}.urg-grid .ph{min-height:120px}}

/* who — colunas com ícones (estilo PQ7) */
.whosec{padding:44px 0}
.who-wide{max-width:1180px;margin:0 auto;padding:0 24px}
.whoq{text-align:center}
.whoq-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:34px}
.whoq-grid.n2{grid-template-columns:repeat(2,1fr);max-width:760px;margin:34px auto 0}
@media(min-width:1000px){.whoq-grid.n4{grid-template-columns:repeat(4,1fr)}}
@media(max-width:999px) and (min-width:761px){.whoq-grid.n4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.whoq-grid.n4{grid-template-columns:1fr}}
.whoq-col{padding:8px 30px;position:relative;text-align:center}
.whoq-col+.whoq-col:before{content:"";position:absolute;left:0;top:20px;bottom:20px;width:1px;background:#e2dbc8}
.whoq-ic{width:150px;height:150px;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;font-size:64px}
.whoq-ic img{width:100%;height:100%;object-fit:contain}
.whoq-name{font-weight:800;font-size:21px;color:var(--navy);margin-bottom:10px;line-height:1.25}
.whoq-desc{font-size:17px;color:var(--ink);margin:0;line-height:1.55}
.whoq-xwrap{position:relative;display:inline-block;padding:6px 10px 8px}
.whoq-not .whoq-name{position:relative;z-index:2}
.whoq-x{position:absolute;z-index:1;top:50%;left:50%;transform:translate(-50%,-50%);height:150%;width:auto;pointer-events:none}
.whoq-not .whoq-desc{margin-top:8px}
@media(max-width:760px){
  .who-wide{padding:0 18px}
  .whoq-grid,.whoq-grid.n2{grid-template-columns:1fr;gap:6px;max-width:540px;margin-left:auto;margin-right:auto}
  .whoq-col{display:grid;grid-template-columns:96px 1fr;column-gap:16px;row-gap:2px;align-items:center;text-align:left;padding:16px 4px}
  .whoq-col+.whoq-col:before{left:0;right:0;top:0;bottom:auto;width:auto;height:1px}
  .whoq-ic{grid-column:1;grid-row:1/3;width:88px;height:88px;margin:0;font-size:42px}
  .whoq-name{grid-column:2;grid-row:1;align-self:end;margin:0 0 4px}
  .whoq-desc{grid-column:2;grid-row:2;align-self:start}
  .whoq-not{grid-template-columns:1fr;text-align:center;justify-items:center}
  .whoq-not .whoq-name,.whoq-not .whoq-desc,.whoq-not .whoq-xwrap{grid-column:1}
  .whoq-x{height:140%}
}

/* ===== oferta estilo Infinite Age ===== */

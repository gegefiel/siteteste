.marker{background:linear-gradient(0deg,var(--hl) 0%,var(--hl) 100%);box-decoration-break:clone;-webkit-box-decoration-break:clone;padding:2px 6px}
.quotebig{font-size:21px;font-weight:800;font-style:italic;color:var(--navy);border-left:5px solid var(--orange);padding:6px 0 6px 18px;margin:22px 0}
.forces{display:grid;gap:12px;margin:20px 0}
.force{background:#fff;border:1px solid #e7e0cd;border-left:6px solid var(--red);border-radius:12px;padding:16px 18px;font-size:18px}
.proofcard{background:#fff;border:1px solid #d8d2c0;border-radius:12px;box-shadow:0 2px 7px rgba(44,40,96,.12);padding:12px;margin:22px 0}
.proofcard figcaption{font-size:13.5px;color:#7d7663;font-weight:600;text-align:center;margin-top:8px;text-transform:none;letter-spacing:0}

</style>
<style>


<script>
(function(){
  /* ===== reveal on scroll — puramente cosmético; sem JS tudo já está visível ===== */
  try{
    if(!('IntersectionObserver' in window)) throw 0;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
    },{threshold:.12});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
    setTimeout(function(){
      document.querySelectorAll('.rv:not(.on)').forEach(function(el){
        if(el.getBoundingClientRect().top < window.innerHeight) el.classList.add('on');
      });
    }, 1200);
  }catch(e){ document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('on'); }); }

  /* ===== galeria da oferta (copiada de sonnus-dtc-v2.html) =====
     Sem JS o card continua mostrando a imagem principal + as miniaturas. */
  var galMain=document.getElementById('galMain');
  if(galMain){
    document.querySelectorAll('.gal-thumbs button').forEach(function(b){
      b.addEventListener('click',function(){
        galMain.src=b.getAttribute('data-src');
        document.querySelectorAll('.gal-thumbs button').forEach(function(o){o.classList.remove('on');});
        b.classList.add('on');
      });
    });
  }
})();
</script>
<script>
/* Dynamic shipping-batch dates: sold-out batch = yesterday, 96% sold = +1 day, next batch = +5 days */
(function(){
  var offsets=[-1,1,5];
  var months=["January","February","March","April","May","June","July","August","September","October","November","December"];
  function ord(n){var s=["th","st","nd","rd"],v=n%100;return n+(s[(v-20)%10]||s[v]||s[0]);}
  var els=document.querySelectorAll('.batch-date');
  for(var i=0;i<els.length;i++){
    var d=new Date();
    d.setDate(d.getDate()+offsets[parseInt(els[i].getAttribute('data-batch'),10)]);
    els[i].textContent=months[d.getMonth()]+' '+ord(d.getDate());
  }
})();
</script>

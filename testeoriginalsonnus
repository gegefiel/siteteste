.caption-card{background:#fff;border-radius:12px;box-shadow:0 2px 7px rgba(44,40,96,.14);padding:12px 16px;font-weight:800;font-size:17px;margin:-26px 14px 0;position:relative;text-align:center}
.xlist li,.arrlist li,.dotlist li{list-style:none;display:flex;gap:12px;align-items:flex-start;padding:10px 0;font-size:18.5px}
.xlist li{border-bottom:1px solid #eee6d4}
.xlist .x{color:var(--red);font-weight:900;flex:0 0 auto}
.arrlist .a{color:var(--red);flex:0 0 auto}
.dotlist .d{color:var(--red);flex:0 0 auto;font-size:22px;line-height:1.2}

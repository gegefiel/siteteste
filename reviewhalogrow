                const editorialTooltip = document.getElementById('tbrTooltip');
                if (editorialTooltip) editorialTooltip.classList.remove('show');
                
                reviewsTooltip.classList.add('show');
            }
            
            function hideReviewsTooltip() {
                reviewsTooltip.classList.remove('show');
            }

            if (!isMobile) {
                reviewsBtn.addEventListener('mouseenter', showReviewsTooltip);
                reviewsTooltip.addEventListener('mouseenter', showReviewsTooltip);


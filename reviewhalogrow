<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle Editorial Standards button
        const editorialBtn = document.getElementById('tbrEditorialBtn');
        const editorialTooltip = document.getElementById('tbrTooltip');
        
        if (editorialBtn && editorialTooltip) {
            // Force the button to be visible (backup JavaScript method)
            editorialBtn.style.display = 'inline-block';
            editorialBtn.style.opacity = '1';
            editorialBtn.style.visibility = 'visible';
            
            const isMobile = window.innerWidth <= 768;
            
            function showEditorialTooltip() {
                // Hide other tooltips first
                const reviewsTooltip = document.getElementById('tbrReviewsTooltip');
                if (reviewsTooltip) reviewsTooltip.classList.remove('show');
                
                editorialTooltip.classList.add('show');
            }
            
            function hideEditorialTooltip() {
                editorialTooltip.classList.remove('show');
            }

            if (!isMobile) {
                editorialBtn.addEventListener('mouseenter', showEditorialTooltip);
                editorialTooltip.addEventListener('mouseenter', showEditorialTooltip);

                editorialBtn.addEventListener('mouseleave', function() {
                    setTimeout(() => {
                        if (!editorialBtn.matches(':hover') && !editorialTooltip.matches(':hover')) {
                            hideEditorialTooltip();
                        }
                    }, 100);
                });
                editorialTooltip.addEventListener('mouseleave', function() {
                    setTimeout(() => {
                        if (!editorialBtn.matches(':hover') && !editorialTooltip.matches(':hover')) {
                            hideEditorialTooltip();
                        }
                    }, 100);
                });
            } else {
                editorialBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (editorialTooltip.classList.contains('show')) {
                        hideEditorialTooltip();
                    } else {
                        showEditorialTooltip();
                    }
                });
            }
        }
        
        // Handle Reviews Collection Process button
        const reviewsBtn = document.getElementById('tbrReviewsBtn');
        const reviewsTooltip = document.getElementById('tbrReviewsTooltip');
        
        if (reviewsBtn && reviewsTooltip) {
            // Force the button to be visible (backup JavaScript method)
